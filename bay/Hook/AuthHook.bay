namespace Runtime.Auth.Hook;

use Runtime.Auth.Api.LoginApi;
use Runtime.Auth.Components.UserSettings;
use Runtime.Crypt.JWT;
use Runtime.Web.Annotations.Api;
use Runtime.Web.Hooks.AppHook as BaseAppHook;
use Runtime.Web.RenderContainer;
use Runtime.Web.RouteList;
use Runtime.Web.RouteModel;


class AuthHook extends BaseAppHook
{
	UserSettings settings = null;
	
	
	/**
	 * Setup hook params
	 */
	void setup(Dict params)
	{
		parent(params);
		
		if (params == null) return;
		if (params.has("settings")) this.settings = params.get("settings");
	}
	
	
	/**
	 * Register hooks
	 */
	void register_hooks()
	{
		#ifdef BACKEND then
		this.register(static::FIND_API);
		this.register(static::ROUTE_BEFORE);
		this.register(static::ROUTES_INIT);
		#endif
	}
	
	
	#ifdef BACKEND then
	
	/**
	 * Find api
	 */
	void find_api(Map params)
	{
		string api_name = params.get("api_name");
		Api annotation = params.get("annotation");
		if (annotation) return;
		
		/* Setup login api */
		if (api_name == this.settings.getApiName())
		{
			Api annotation = new Api(classof LoginApi, {
				"settings": this.settings,
			});
			params.set("annotation", annotation);
		}
	}
	
	
	/**
	 * Routes init
	 */
	async void routes_init(Map params)
	{
		RouteList routes = params.get("routes");
		
		/* Add login */
		if (not routes.hasRoute(this.settings.getParam("login.name")))
		{
			routes.addRoute(this.settings.createRoute("login"));
		}
		
		/* Add logout */
		if (not routes.hasRoute(this.settings.getParam("logout.name")))
		{
			routes.addRoute(this.settings.createRoute("logout"));
		}
	}
	
	
	/**
	 * Route before
	 */
	async void route_before(Map params)
	{
		RenderContainer container = params.get("container");
		string token_name = this.settings.getTokenName();
		string jwt_algo = @.env(token_name ~ "_jwt_algo");
		string jwt_secret_key = @.env(token_name ~ "_jwt_secret_key");
		string jwt_string = container.request.cookies.get(token_name);
		
		/* Decode JWT */
		JWT jwt = JWT::decode(jwt_string, jwt_secret_key);
		if (jwt and jwt.isCorrect())
		{
			container.layout.storage.params.set(token_name, {
				"data": jwt.data,
				"token": jwt.token,
			});
		}
	}
	
	#endif
}