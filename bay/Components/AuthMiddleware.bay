namespace Runtime.Auth.Components;

use Runtime.Auth.UserSettings;
use Runtime.Auth.Components.LoginPage.LoginPageModel;
use Runtime.Web.BaseMiddleware;
use Runtime.Web.RenderContainer;


class AuthMiddleware extends BaseMiddleware
{
	UserSettings settings = null;
	
	
	/**
	 * Create hook
	 */
	void constructor(UserSettings settings)
	{
		parent();
		this.settings = settings;
	}
	
	
	/**
	 * Apply middleware
	 */
	async void apply(RenderContainer container)
	{
		if (container.layout == null) return;
		
		/* Get JWT */
		Dict jwt = container.layout.storage.params.get(this.settings.getTokenName());
		if (jwt != null) return;
		
		/* Setup new layout */
		container.changeLayout(this.settings.getLayout());
		
		/* Render login page */
		container.renderPageModel(classof LoginPageModel, {
			"user_settings": this.settings,
		});
	}
}