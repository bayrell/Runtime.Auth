namespace Runtime.Auth.Components.LogoutPage;

use Runtime.Serializer;
use Runtime.Auth.Components.LogoutPage.LogoutPage;
use Runtime.Auth.Components.UserSettings;
use Runtime.Web.ApiResult;
use Runtime.Web.BasePageModel;
use Runtime.Widget.WidgetResultModel;


class LogoutPageModel extends BasePageModel
{
	string component = classof LogoutPage;
	UserSettings user_settings = null;
	WidgetResultModel result = null;
	
	
	/**
	 * Init widget settings
	 */
	void initParams(Dict params)
	{
		parent(params);
		
		if (params == null) return;
		if (params.has("user_settings")) this.user_settings = params.get("user_settings");
	}
	
	
	/**
	 * Process frontend data
	 */
	void serialize(Serializer serializer, Map data)
	{
		serializer.process(this, "user_settings", data);
		parent(serializer, data);
	}
	
	
	/**
	 * Init widget settings
	 */
	void initWidget(Dict params)
	{
		parent(params);
		
		this.result = this.addWidget(
			classof WidgetResultModel,
			{
				"widget_name": "result",
				"styles": ["margin_top"],
			}
		);
	}
	
	
	/**
	 * Logout
	 */
	async void logout()
	{
		this.result.setWaitMessage();
		ApiResult result = await this.layout.callApi
		{
			"api_name": this.user_settings.get("api_name"),
			"method_name": "actionLogout",
		};
		this.result.setApiResult(result);
		
		/* If success */
		if (result.isSuccess())
		{
			string redirect_url = this.user_settings.getMainPage(this.layout);
			document.location = redirect_url;
		}
	}
}