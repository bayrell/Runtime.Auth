namespace Runtime.Auth.Api;

use Runtime.Auth.Components.UserSettings;
use Runtime.Auth.Service.UserService;
use Runtime.Crypt.JWT;
use Runtime.Web.BaseApi;
use Runtime.Web.Cookie;
use Runtime.Web.Annotations.ApiMethod;


class LoginApi extends BaseApi
{
	UserSettings settings = null;
	
	
	/**
	 * Returns api name
	 */
	static string getApiName() => "";
	
	
	/**
	 * Setup params
	 */
	void setup(Dict params)
	{
		parent(params);
		
		if (params == null) return;
		if (params.has("settings")) this.settings = params.get("settings");
	}
	
	
	/**
	 * Returns service
	 */
	UserService createService() => new UserService(this.settings);
	
	
	/**
	 * Action login
	 */
	@ApiMethod
	async void actionLogin()
	{
		UserService service = this.createService();
		
		string login = this.post_data["item", "login"];
		string password = this.post_data["item", "password"];
		JWT jwt = await service.login(login, password);
		
		/* Add cookie */
		Cookie cookie = new Cookie{
			"name": service.settings.getTokenName(),
			"expires": jwt.data.get("expires"),
			"value": jwt.token,
		};
		this.result.addCookie(cookie);
		
		/* Set result */
		this.success();
	}
	
	
	/**
	 * Action logout
	 */
	@ApiMethod
	async void actionLogout()
	{
		UserService service = this.createService();
		
		/* Clear cookie */
		Cookie cookie = new Cookie{
			"name": service.settings.getTokenName(),
			"expires": 0,
			"value": "",
		};
		this.result.addCookie(cookie);
		
		/* Set result */
		this.success();
	}
}